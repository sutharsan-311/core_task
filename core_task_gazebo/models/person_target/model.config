<?xml version="1.0"?>
<model>
  <name>person_target</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Standing person used as the YOLO "person" target for the vision
    detect-and-follow task. Solid (has a collision box) so the robot stops at
    it instead of driving through. Mesh is Gazebo's stock walk.dae, vendored
    here so the repo is self-contained.
  </description>
</model>
