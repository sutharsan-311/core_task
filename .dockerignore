# Host-built ROS artifacts — rebuilt inside the image, must not leak in.
build/
install/
log/
src/core_task/logs/

# VCS and editor cruft.
.git/
.superpowers/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# Not needed inside the image; excluding it means editing the Dockerfile
# doesn't invalidate the COPY-and-onward layer cache below it.
Dockerfile
docker-run.sh
